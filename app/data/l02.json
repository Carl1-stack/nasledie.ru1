{"num":2,"ru":"Здра́вствуйте! Пе́рвый день в Москве́","pr":null,"ar":"أهلًا! أول يوم في موسكو","situation":"عمار، طالب مصري، لسه واصل موسكو. هيسجّل في الهوستل، ويقابل جارته الروسية ليرا في المطبخ، ويتعلم يسلّم ويشكر ويعتذر ويسأل «ده إيه؟» و«مين ده؟».","dialogues":[{"id":"d1","ru":"На ресе́пшене","ar":"في ريسبشن الهوستل","scene":"عمار وصل الهوستل في موسكو. الموظفة اسمها أولجا بيتروڤنا.","lines":[{"who":"О́льга Петро́вна","ru":"Здра́вствуйте! Слу́шаю вас.","ar":"أهلًا وسهلًا! أؤمر؟","pr":null,"a":"h184548e93d","slow":"h23ec480305"},{"who":"Ома́р","ru":"Здра́вствуйте! Я Ома́р. Ома́р Хасса́н.","ar":"أهلًا! أنا عمار. عمار حسن.","pr":null,"a":"h99426b5c58","slow":"h8a45ed190a"},{"who":"О́льга Петро́вна","ru":"Ома́р Хасса́н… Да, есть. Вот ключ.","ar":"عمار حسن… أيوه، موجود. اتفضل المفتاح.","pr":null,"a":"h784426e6c6","slow":"h142c293a60"},{"who":"Ома́р","ru":"Спаси́бо!","ar":"شكرًا!","pr":null,"a":"hb434cb54a7","slow":"hf2bcd4d334"},{"who":"О́льга Петро́вна","ru":"Пожа́луйста. А э́то паро́ль.","ar":"العفو. ودي كلمة السر.","pr":null,"a":"h15b4618e91","slow":"hb72ead7bc1"},{"who":"Ома́р","ru":"Извини́те, что зна́чит «паро́ль»?","ar":"لو سمحتي، يعني إيه «پارول»؟","pr":null,"a":"hd3f1c8f82c","slow":"h26b82f7181"},{"who":"О́льга Петро́вна","ru":"Ну, э́то код. Код для вайфа́я.","ar":"يعني كود. كود الواي فاي.","pr":null,"a":"h30d13629c1","slow":"hf180194830"},{"who":"Ома́р","ru":"А-а, поня́тно! Спаси́бо большо́е!","ar":"آه، فهمت! شكرًا جدًا!","pr":null,"a":"h62c6dfba9a","slow":"h1da847c0aa"},{"who":"О́льга Петро́вна","ru":"Не́ за что!","ar":"ولا يهمك! (العفو)","pr":null,"a":"he099668b6e","slow":"hd53251d90c"}],"full":"full_d1","slow":"slow_d1"},{"id":"d2","ru":"На ку́хне","ar":"في مطبخ الهوستل (كلام شبابي)","scene":"بالليل في المطبخ. عمار بيسخّن فلافل، ودخلت ليرا.","lines":[{"who":"Ле́ра","ru":"Ой! Приве́т!","ar":"أوه! أهلًا!","pr":null,"a":"h5651fc55c8","slow":"h0fb68f516a"},{"who":"Ома́р","ru":"Прив! Я Ома́р. А ты?","ar":"هاي! أنا عمار. وإنتِ؟","pr":null,"a":"h856c670d5f","slow":"h043ec72678"},{"who":"Ле́ра","ru":"Ле́ра. Ты студе́нт, да?","ar":"ليرا. إنت طالب، صح؟","pr":null,"a":"h2451a70f53","slow":"h8c5e951d9e"},{"who":"Ома́р","ru":"Ага́. А ты?","ar":"آه. وإنتِ؟","pr":null,"a":"h70d64d3e94","slow":"hcedc96de62"},{"who":"Ле́ра","ru":"Не, я фото́граф.","ar":"لأ، أنا مصوّرة.","pr":null,"a":"hc2ebac380d","slow":"h2a8608ee11"},{"who":"Ома́р","ru":"О, кру́то!","ar":"الله، جامد!","pr":null,"a":"h9c7e5ed204","slow":"h784b50422f"},{"who":"Ле́ра","ru":"Слу́шай, а что э́то?","ar":"بقولك، وده إيه؟","pr":null,"a":"hc11e52153a","slow":"h8b3e17d9b4"},{"who":"Ома́р","ru":"Э́то фала́фель. Еги́петский!","ar":"ده فلافل. مصري!","pr":null,"a":"h7a04630106","slow":"hb60ab62caa"},{"who":"Ле́ра","ru":"Фала́фель? А что э́то зна́чит?","ar":"فلافل؟ يعني إيه ده؟","pr":null,"a":"he12eea1ae3","slow":"ha51d60e83f"},{"who":"Ома́р","ru":"Ну, э́то еда́. На, попро́буй!","ar":"يعني أكل. خدي، دوقي!","pr":null,"a":"hb36319d15e","slow":"hac81128b6d"},{"who":"Ле́ра","ru":"М-м-м… Вку́сно! Спаси́бо!","ar":"ممم… طعم! شكرًا!","pr":null,"a":"h035d714599","slow":"hd53eeee9e3"},{"who":"Ле́ра","ru":"Ой, всё, мне пора́. Пока́!","ar":"أوه، خلاص، لازم أمشي. باي!","pr":null,"a":"ha82c97c651","slow":"h14c3f7361e"},{"who":"Ома́р","ru":"Дава́й, пока́!","ar":"يلا، باي!","pr":null,"a":"h7d8cbce6be","slow":"h4b8605feba"}],"full":"full_d2","slow":"slow_d2"}],"glossary":[{"ru":"здра́вствуйте","ar":"أهلًا (رسمي)","pr":"زدراستڤويتي","a":"hf2deb15595"},{"ru":"приве́т","ar":"أهلًا (للأصحاب)","pr":"پريڤيت","a":"h86e4151e3e"},{"ru":"пока́","ar":"سلام","pr":"پاكا","a":"h2dfcc72afa"},{"ru":"до свида́ния","ar":"مع السلامة","pr":"دو سڤيدانييا","a":"hcf58348fc8"},{"ru":"Как дела́?","ar":"عامل إيه؟","pr":"كاك ديلا","a":"h4588436741"},{"ru":"э́то","ar":"ده / دي","pr":"إتا","a":"h2890f16505"},{"ru":"что","ar":"إيه","pr":"شتو","a":"hf4ccd94a2d"},{"ru":"кто","ar":"مين","pr":"كتو","a":"hb41b2a8258"},{"ru":"я","ar":"أنا","pr":"يا","a":"hd9f5dc8b4b"},{"ru":"ты","ar":"إنت","pr":"تي","a":"hc667ec0326"},{"ru":"хорошо